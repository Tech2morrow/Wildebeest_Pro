Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Alpha: 0.35
      Cell Size: 0.5
      Color: 58; 72; 86
    - Class: rviz/Map
      Name: Navigation map
      Topic: /map
      Alpha: 0.65
      Color Scheme: map
    - Class: rviz/RobotModel
      Name: Wildebeest Pro
      Description Source: Topic
      Description Topic: /robot_description
    - Class: rviz/LaserScan
      Name: LiDAR
      Topic: /scan
      Size (m): 0.025
      Style: Points
      Color: 38; 224; 190
    - Class: rviz/Path
      Name: Global plan
      Topic: /move_base/NavfnROS/plan
      Color: 0; 170; 255
    - Class: rviz/Path
      Name: Local plan
      Topic: /move_base/DWAPlannerROS/local_plan
      Color: 255; 178; 50
    - Class: rviz/TF
      Name: TF
      Show Names: false
      Marker Scale: 0.2
  Global Options:
    Background Color: 10; 16; 24
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 10
      Pitch: 1.05
      Yaw: 0.78
Window Geometry:
  Height: 900
  Width: 1440
