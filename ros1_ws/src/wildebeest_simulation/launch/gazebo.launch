<?xml version="1.0"?>
<launch>
  <arg name="world" default="$(find wildebeest_simulation)/worlds/test_arena.world"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="simulate_gps" default="false"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <!-- Wheel radius plus 1.4 mm avoids initial ground interpenetration. -->
  <arg name="z" default="0.035"/>
  <arg name="yaw" default="0.0"/>

  <param name="use_sim_time" value="true"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <include file="$(find wildebeest_description)/launch/description.launch">
    <arg name="use_sim" value="true"/>
    <arg name="simulate_gps" value="$(arg simulate_gps)"/>
  </include>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_wildebeest" output="screen"
        args="-urdf -param robot_description -model wildebeest_pro -x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw)"/>

  <rosparam command="load" file="$(find wildebeest_simulation)/config/controllers.yaml"/>
  <node pkg="controller_manager" type="spawner" name="controller_spawner" output="screen"
        args="joint_state_controller base_controller"/>
</launch>
