<?xml version="1.0"?>
<package format="2">
  <name>wildebeest_base</name>
  <version>0.1.0</version>
  <description>Fail-safe Arduino serial bridge and side-aggregate skid-steer odometry for Wildebeest Pro.</description>

  <maintainer email="maintainers@wildebeest-pro.org">Wildebeest Pro Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>python3-serial</exec_depend>

  <test_depend>rostest</test_depend>
  <test_depend>python3-nose</test_depend>

  <export/>
</package>
