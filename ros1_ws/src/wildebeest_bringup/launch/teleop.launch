<?xml version="1.0"?>
<launch>
  <arg name="joystick" default="true"/>
  <arg name="joy_device" default="/dev/input/js0"/>
  <arg name="output_cmd_vel" default="/cmd_vel"/>

  <node pkg="twist_mux" type="twist_mux" name="twist_mux" output="screen">
    <rosparam command="load" file="$(find wildebeest_bringup)/config/twist_mux.yaml"/>
    <remap from="cmd_vel_out" to="$(arg output_cmd_vel)"/>
  </node>

  <group if="$(arg joystick)">
    <node pkg="joy" type="joy_node" name="joy" output="screen">
      <param name="dev" value="$(arg joy_device)"/>
      <param name="deadzone" value="0.08"/>
      <param name="autorepeat_rate" value="20.0"/>
      <param name="coalesce_interval" value="0.01"/>
    </node>
    <node pkg="teleop_twist_joy" type="teleop_node" name="teleop_twist_joy" output="screen">
      <rosparam command="load" file="$(find wildebeest_bringup)/config/joystick.yaml"/>
      <remap from="cmd_vel" to="/cmd_vel_joy"/>
    </node>
  </group>
</launch>
