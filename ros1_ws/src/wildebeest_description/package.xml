<?xml version="1.0"?>
<package format="2">
  <name>wildebeest_description</name>
  <version>0.1.0</version>
  <description>CAD-proportioned four-wheel skid-steer URDF, sensor frames, ros_control transmissions, and RViz view for Wildebeest Pro.</description>

  <maintainer email="maintainers@wildebeest-pro.org">Wildebeest Pro Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>robot_state_publisher</depend>
  <depend>urdf</depend>
  <depend>xacro</depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz</exec_depend>

  <export>
    <!-- Makes media/materials/scripts available to Gazebo Classic through
         GAZEBO_RESOURCE_PATH when gazebo_ros loads the package exports. -->
    <gazebo_ros gazebo_media_path="${prefix}"/>
  </export>
</package>
