// Sensor identification colors shared with the URDF and ROS 2 model.
// They identify hardware only; they do not communicate runtime status.

material Wildebeest/SensorLidarOrange
{
  technique
  {
    pass
    {
      ambient 0.902 0.624 0.000 1.0
      diffuse 0.902 0.624 0.000 1.0
    }
  }
}

