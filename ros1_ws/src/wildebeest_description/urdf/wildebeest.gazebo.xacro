<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wildebeest_gazebo" params="prefix simulate_gps">
    <gazebo reference="${prefix}base_link"><material>Gazebo/Blue</material></gazebo>
    <!-- Lower lateral friction permits the four wheels to scrub during skid steering.
         Tune both coefficients against the real tyres and floor. -->
    <gazebo reference="${prefix}front_left_wheel_link">
      <material>Gazebo/Black</material><mu1>1.3</mu1><mu2>0.45</mu2><fdir1>1 0 0</fdir1><kp>1000000</kp><kd>10</kd>
    </gazebo>
    <gazebo reference="${prefix}rear_left_wheel_link">
      <material>Gazebo/Black</material><mu1>1.3</mu1><mu2>0.45</mu2><fdir1>1 0 0</fdir1><kp>1000000</kp><kd>10</kd>
    </gazebo>
    <gazebo reference="${prefix}front_right_wheel_link">
      <material>Gazebo/Black</material><mu1>1.3</mu1><mu2>0.45</mu2><fdir1>1 0 0</fdir1><kp>1000000</kp><kd>10</kd>
    </gazebo>
    <gazebo reference="${prefix}rear_right_wheel_link">
      <material>Gazebo/Black</material><mu1>1.3</mu1><mu2>0.45</mu2><fdir1>1 0 0</fdir1><kp>1000000</kp><kd>10</kd>
    </gazebo>

    <gazebo>
      <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
        <robotNamespace>/</robotNamespace>
      </plugin>
    </gazebo>

    <gazebo reference="${prefix}lidar_link">
      <material>Wildebeest/SensorLidarOrange</material>
      <sensor name="lidar" type="ray">
        <always_on>true</always_on><update_rate>10</update_rate><visualize>true</visualize>
        <pose>0 0 0 0 0 0</pose>
        <ray>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.008</stddev></noise>
        </ray>
        <plugin name="lidar_ros" filename="libgazebo_ros_laser.so">
          <topicName>/scan</topicName><frameName>${prefix}lidar_link</frameName>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="${prefix}camera_link">
      <material>Wildebeest/SensorCameraSkyBlue</material>
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on><update_rate>20</update_rate><visualize>false</visualize>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>50.0</far></clip>
        </camera>
        <plugin name="camera_ros" filename="libgazebo_ros_camera.so">
          <cameraName>camera</cameraName><imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName><frameName>${prefix}camera_optical_frame</frameName>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="${prefix}imu_link">
      <material>Wildebeest/SensorImuRose</material>
      <sensor name="imu" type="imu">
        <always_on>true</always_on><update_rate>50</update_rate>
        <plugin name="imu_ros" filename="libgazebo_ros_imu_sensor.so">
          <topicName>/imu/data_raw</topicName><bodyName>${prefix}imu_link</bodyName>
          <frameName>${prefix}imu_link</frameName><gaussianNoise>0.002</gaussianNoise>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="${prefix}ultrasonic_front_link">
      <material>Wildebeest/SensorUltrasonicVermillion</material>
      <sensor name="front_ultrasonic" type="ray">
        <always_on>true</always_on><update_rate>10</update_rate>
        <ray>
          <scan><horizontal><samples>7</samples><resolution>1</resolution><min_angle>-0.13</min_angle><max_angle>0.13</max_angle></horizontal></scan>
          <range><min>0.02</min><max>2.0</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="range_ros" filename="libgazebo_ros_range.so">
          <topicName>/range/front</topicName><frameName>${prefix}ultrasonic_front_link</frameName>
          <radiation>ultrasound</radiation><fov>0.26</fov><gaussianNoise>0.005</gaussianNoise>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="${prefix}gps_link">
      <material>Wildebeest/SensorGnssYellow</material>
    </gazebo>

    <xacro:if value="${simulate_gps}">
      <!-- Optional because hector_gazebo_plugins is not in a minimal Noetic install. -->
      <gazebo>
        <plugin name="gps_ros" filename="libhector_gazebo_ros_gps.so">
          <bodyName>${prefix}gps_link</bodyName><frameId>${prefix}gps_link</frameId>
          <topicName>/gps/fix</topicName><velocityTopicName>/gps/velocity</velocityTopicName>
          <updateRate>5.0</updateRate>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
