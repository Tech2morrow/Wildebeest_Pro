<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="wildebeest_blue">
    <color rgba="0.025 0.35 0.62 1.0"/>
  </material>
  <material name="wildebeest_dark">
    <color rgba="0.035 0.055 0.075 1.0"/>
  </material>
  <material name="wildebeest_accent">
    <color rgba="0.1 0.82 0.68 1.0"/>
  </material>
  <!-- High-contrast sensor identification palette. These colors identify
       hardware in RViz/Gazebo; they do not report sensor health or status. -->
  <material name="sensor_lidar_orange">
    <color rgba="0.902 0.624 0.000 1.0"/>
  </material>
  <material name="sensor_imu_rose">
    <color rgba="0.800 0.475 0.655 1.0"/>
  </material>
  <material name="sensor_gnss_yellow">
    <color rgba="0.941 0.894 0.259 1.0"/>
  </material>
  <material name="sensor_camera_sky_blue">
    <color rgba="0.337 0.706 0.914 1.0"/>
  </material>
  <material name="sensor_ultrasonic_vermillion">
    <color rgba="0.835 0.369 0.000 1.0"/>
  </material>
</robot>
