<?xml version="1.0"?>
<sdf version="1.9">
  <world name="wildebeest_test_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>5.64e-6 2.29e-5 -4.24e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <scene>
      <ambient>0.22 0.25 0.30 1</ambient>
      <background>0.035 0.045 0.065 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>25.2048</latitude_deg>
      <longitude_deg>55.2708</longitude_deg>
      <elevation>5</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.92 0.92 0.88 1</diffuse>
      <specular>0.28 0.28 0.28 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.25 -0.88</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.12 0.15 0.19 1</ambient>
            <diffuse>0.16 0.20 0.25 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="cyan_gate">
      <static>true</static>
      <pose>3 0 0 0 0 0</pose>
      <link name="link">
        <collision name="left_collision">
          <pose>0 1.2 0.6 0 0 0</pose>
          <geometry><box><size>0.18 0.18 1.2</size></box></geometry>
        </collision>
        <visual name="left_visual">
          <pose>0 1.2 0.6 0 0 0</pose>
          <geometry><box><size>0.18 0.18 1.2</size></box></geometry>
          <material><diffuse>0.0 0.75 0.85 1</diffuse></material>
        </visual>
        <collision name="right_collision">
          <pose>0 -1.2 0.6 0 0 0</pose>
          <geometry><box><size>0.18 0.18 1.2</size></box></geometry>
        </collision>
        <visual name="right_visual">
          <pose>0 -1.2 0.6 0 0 0</pose>
          <geometry><box><size>0.18 0.18 1.2</size></box></geometry>
          <material><diffuse>0.0 0.75 0.85 1</diffuse></material>
        </visual>
        <collision name="top_collision">
          <pose>0 0 1.15 0 0 0</pose>
          <geometry><box><size>0.18 2.58 0.18</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 1.15 0 0 0</pose>
          <geometry><box><size>0.18 2.58 0.18</size></box></geometry>
          <material><diffuse>0.0 0.75 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_red">
      <static>true</static>
      <pose>1.6 -1.8 0.3 0 0 0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.5 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.5 0.6</size></box></geometry>
          <material><diffuse>0.82 0.08 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_yellow">
      <static>true</static>
      <pose>-2.2 1.5 0.45 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.38</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.38</radius><length>0.9</length></cylinder></geometry>
          <material><diffuse>0.95 0.62 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
