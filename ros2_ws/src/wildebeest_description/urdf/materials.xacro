<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="wildebeest_blue">
    <color rgba="0.035 0.30 0.58 1.0"/>
  </material>
  <material name="wildebeest_cyan">
    <color rgba="0.0 0.76 0.86 1.0"/>
  </material>
  <material name="wildebeest_graphite">
    <color rgba="0.055 0.065 0.08 1.0"/>
  </material>
  <material name="wildebeest_rubber">
    <color rgba="0.018 0.022 0.028 1.0"/>
  </material>
  <material name="wildebeest_green">
    <color rgba="0.10 0.62 0.30 1.0"/>
  </material>

  <!-- Sensor-only colors are based on the color-blind-conscious Okabe-Ito
       palette.  Their semantic names keep RViz and Gazebo visuals legible. -->
  <material name="wildebeest_sensor_lidar_orange">
    <color rgba="0.902 0.624 0.000 1.0"/>
  </material>
  <material name="wildebeest_sensor_imu_rose">
    <color rgba="0.800 0.475 0.655 1.0"/>
  </material>
  <material name="wildebeest_sensor_gnss_yellow">
    <color rgba="0.941 0.894 0.259 1.0"/>
  </material>
  <material name="wildebeest_sensor_camera_sky">
    <color rgba="0.337 0.706 0.914 1.0"/>
  </material>
  <material name="wildebeest_sensor_ultrasonic_vermillion">
    <color rgba="0.835 0.369 0.000 1.0"/>
  </material>
</robot>
